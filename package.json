{
  "name": "music_app_rn",
  "version": "1.0.3",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "react-native start --port 8092",
    "ios": "react-native run-ios --port 8092",
    "android": "react-native run-android --port 8092",
    "macos": "react-native run-macos --port 8092",
    "windows": "react-native run-windows --arch x64 --msbuildprops UseFabric=true,UseExperimentalNuget=true,RnwNewArch=true,WindowsAppSDKVerifyTransitiveDependencies=false,PlatformToolset=v145,WindowsTargetPlatformVersion=10.0.26100.0,TargetPlatformVersion=10.0.26100.0",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "test:watch": "vitest",
    "test:integration": "vitest run src/documents/editing-integration.test.ts",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\"",
    "verify": "bun run format:check && bun run typecheck && bun run lint && bun run test:unit",
    "postinstall": "node scripts/unshare-patched-files.cjs && patch-package --error-on-fail",
    "prestart": "node scripts/generate-theme-css.js",
    "premacos": "node scripts/generate-theme-css.js",
    "prewindows": "node scripts/generate-theme-css.js",
    "test:components": "jest",
    "soundfont": "node scripts/fetch-soundfont-packs.mjs",
    "test:unit": "vitest run"
  },
